{
  "name": "newsflow",
  "version": "2.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node scripts/check.mjs && node scripts/check-language.mjs && node scripts/check-membership.mjs",
    "build": "node scripts/build.mjs",
    "content:check": "node scripts/update-content.mjs --check",
    "content:update": "node scripts/update-content.mjs",
    "feedback:profile": "node skills/newsflow-recommender/scripts/build-profile.mjs",
    "feedback:rank": "node skills/newsflow-recommender/scripts/rank-signals.mjs",
    "supabase:catalog": "node scripts/sync-supabase-catalog.mjs",
    "supabase:status": "supabase status",
    "supabase:test": "supabase test db",
    "supabase:advisors": "supabase db advisors --local --type all --level info",
    "publish:edition": "node scripts/publish-edition.mjs",
    "publish:edition:dry-run": "node scripts/publish-edition.mjs --dry-run --force"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.0"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "supabase": "2.111.0"
  }
}
