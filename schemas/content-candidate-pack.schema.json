{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://newsflow.local/schemas/content-candidate-pack.schema.json",
  "title": "NewsFlow content candidate pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "edition_id", "run", "candidates"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "edition_id": {"type": "string", "minLength": 1},
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["as_of", "coverage_start", "coverage_end", "timezone", "actor"],
      "properties": {
        "as_of": {"type": "string", "format": "date-time"},
        "coverage_start": {"type": "string", "format": "date-time"},
        "coverage_end": {"type": "string", "format": "date-time"},
        "timezone": {"const": "Asia/Shanghai"},
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["agent_id", "runtime", "workflow_id", "workflow_version"],
          "properties": {
            "agent_id": {"type": "string", "minLength": 1},
            "runtime": {"type": "string", "minLength": 1},
            "workflow_id": {"const": "newsflow-content-update"},
            "workflow_version": {"const": "1.0.0"},
            "model": {"type": "string", "minLength": 1}
          }
        },
        "collection_observations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_ids_scanned",
            "scout_ids_scanned",
            "x_topic_query_ids_run",
            "x_query_runtime",
            "x_post_read_count",
            "material_lead_count",
            "full_text_review_count"
          ],
          "properties": {
            "source_ids_scanned": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "scout_ids_scanned": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "storyline_ids_scanned": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "surface_types_scanned": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "x_topic_query_ids_run": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "x_query_runtime": {"enum": ["native_x", "not_run"]},
            "x_post_read_count": {"type": "integer", "minimum": 0},
            "origin_yield": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "id", "lead_count", "full_text_review_count", "candidate_count"],
                "properties": {
                  "type": {"enum": ["green_lane", "x_scout", "x_topic", "specialist", "primary", "institutional", "mainstream", "dataset", "paper", "conference", "filing", "engineering_procurement", "other"]},
                  "id": {"type": "string", "minLength": 1},
                  "lead_count": {"type": "integer", "minimum": 0},
                  "full_text_review_count": {"type": "integer", "minimum": 0},
                  "candidate_count": {"type": "integer", "minimum": 0}
                }
              }
            },
            "material_lead_count": {"type": "integer", "minimum": 0},
            "full_text_review_count": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"}
    }
  },
  "$defs": {
    "nonEmptyText": {"type": "string", "minLength": 1},
    "score": {"type": "number", "minimum": 0, "maximum": 5},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "channel_id", "event_type", "event_date", "title", "url",
        "published_at", "retrieved_at", "short_summary", "long_summary", "tags",
        "storyline_ids", "scores", "verification", "evidence"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyText"},
        "channel_id": {"enum": ["ai-infrastructure", "ccus-energy-transition"]},
        "event_type": {"$ref": "#/$defs/nonEmptyText"},
        "event_date": {"type": "string", "format": "date"},
        "title": {"$ref": "#/$defs/nonEmptyText"},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "published_at": {"type": "string", "format": "date-time"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "short_summary": {"$ref": "#/$defs/nonEmptyText"},
        "long_summary": {"$ref": "#/$defs/nonEmptyText"},
        "tags": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyText"}},
        "storyline_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyText"}},
        "discovery_origin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id"],
          "properties": {
            "type": {"enum": ["green_lane", "x_scout", "x_topic", "specialist", "primary", "institutional", "mainstream", "dataset", "paper", "conference", "filing", "engineering_procurement", "other"]},
            "id": {"type": "string", "minLength": 1},
            "url": {"type": "string", "format": "uri", "pattern": "^https://"}
          }
        },
        "scores": {
          "type": "object",
          "additionalProperties": false,
          "required": ["facts", "source", "timeliness", "news_quality", "industry_impact"],
          "properties": {
            "facts": {"$ref": "#/$defs/score"},
            "source": {"$ref": "#/$defs/score"},
            "timeliness": {"$ref": "#/$defs/score"},
            "news_quality": {"$ref": "#/$defs/score"},
            "industry_impact": {"$ref": "#/$defs/score"}
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["full_text_accessed", "summary_supported_sentence_by_sentence"],
          "properties": {
            "full_text_accessed": {"const": true},
            "summary_supported_sentence_by_sentence": {"const": true},
            "attributed_to_source": {"type": "boolean"},
            "stakeholder_position_attributed": {"type": "boolean"},
            "report_context": {
              "type": "object",
              "additionalProperties": false,
              "required": ["report_title", "report_version", "publication_date_verified", "data_cutoff", "methodology_reviewed", "observed_and_modeled_separated"],
              "properties": {
                "report_title": {"$ref": "#/$defs/nonEmptyText"},
                "report_version": {"$ref": "#/$defs/nonEmptyText"},
                "publication_date_verified": {"const": true},
                "data_cutoff": {"type": "string", "pattern": "^(\\d{4}-\\d{2}-\\d{2}|not_disclosed)$"},
                "methodology_reviewed": {"const": true},
                "observed_and_modeled_separated": {"const": true}
              }
            }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim", "source_excerpt", "source_url"],
            "properties": {
              "claim": {"$ref": "#/$defs/nonEmptyText"},
              "source_excerpt": {"$ref": "#/$defs/nonEmptyText"},
              "source_url": {"type": "string", "format": "uri", "pattern": "^https://"}
            }
          }
        }
      }
    }
  }
}
