{
  "schema_version": "1.0",
  "policy_version": "1.1.0",
  "objective": "Maximize decision-relevant information gain after evidence and attention gates, without optimizing for clicks alone.",
  "feedback": {
    "storage_key": "newsflow_feedback_v1",
    "hidden_key": "newsflow_hidden_signals_v1",
    "max_local_events": 500,
    "allowed_actions": {
      "useful": 1.5,
      "bookmark": 1.0,
      "unbookmark": -0.25,
      "not_interested": -1.5,
      "hide": 0.0,
      "restore": 0.0,
      "already_known": -0.6,
      "too_shallow": -0.8,
      "too_late": -0.8,
      "evidence_issue": 0.0
    },
    "explicit_actions": [
      "useful",
      "not_interested",
      "hide",
      "restore",
      "already_known",
      "too_shallow",
      "too_late",
      "evidence_issue"
    ],
    "collect_personal_identifiers": false
  },
  "learning": {
    "half_life_days": 180,
    "minimum_events_before_personalization": 3,
    "affinity_scale": 3,
    "maximum_absolute_affinity": 1
  },
  "ranking": {
    "quality_weight": 1,
    "attention_weight": 0.3,
    "freshness_boost_max": 0.5,
    "freshness_half_life_days": 30,
    "chief_cover_boost": 1,
    "editor_consensus_boost_max": 0.45,
    "reader_consensus_boost_max": 0.15,
    "reader_consensus_minimum": 3,
    "preference_boost_max": 0.15,
    "exploration_share": 0.12,
    "minimum_channel_share": 0.2
  },
  "cloud_sync": {
    "enabled": true,
    "provider": "supabase",
    "mode": "current_state_upsert",
    "local_first": true,
    "fallback_to_export": true,
    "maximum_batch_rows": 12,
    "maximum_rows_per_reader": 256,
    "debounce_seconds": 8,
    "sync_realtime": false,
    "upload_exposure_events": false,
    "upload_titles_summaries_or_excerpts": false,
    "raw_event_retention_days": 0,
    "store_server_profiles": false,
    "required_rls_owner_column": "user_id"
  },
  "governance": {
    "preference_may_override_quality_gates": false,
    "agent_may_edit_edition": false,
    "agent_may_self_approve_sources": false,
    "policy_changes_require_human_review": true,
    "raw_feedback_is_append_only": false,
    "publication_authority_order": ["evidence_gate", "editor_in_chief", "editor_consensus", "reader_consensus"]
  }
}
