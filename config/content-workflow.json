{
  "schema_version": "1.0",
  "workflow_id": "newsflow-content-update",
  "workflow_version": "1.0.0",
  "entrypoint": "WORKFLOW.md",
  "timezone": "Asia/Shanghai",
  "required_inputs": [
    "public/data/edition.json",
    "public/data/news.json",
    "public/data/storylines.json",
    "config/content-sources.json",
    "config/content-discovery.json",
    "config/content-scouts.json",
    "config/recommendation-policy.json",
    "content/state/reader-profile.json",
    "docs/attention-policy.md",
    "docs/ai-five-layer-watchlist.md",
    "docs/domain-watchlist.md",
    "docs/x-scout-watchlist.md",
    "docs/ccus-report-watchlist.md",
    "content/state/review-history.json"
  ],
  "dynamic_discovery_inputs": [
    "supabase:public.newsflow_editorial_referrals(status=queued, oldest-first, limit=1)",
    "x:GET /2/tweets/search/recent when X_BEARER_TOKEN is configured"
  ],
  "exchange_contract": {
    "candidate_pack_schema": "schemas/content-candidate-pack.schema.json",
    "candidate_pack_version": "1.0",
    "required_actor_fields": [
      "agent_id",
      "runtime",
      "workflow_id",
      "workflow_version"
    ]
  },
  "candidate_draft": {
    "path": "content/inbox/*.json",
    "git_tracked": false,
    "lifetime": "transient"
  },
  "scheduled_runtime": {
    "repository_shell_required": false,
    "github_contents_access": "read_write_control_file",
    "github_issue_access": "none",
    "public_web_discovery_required": true,
    "base64_encoding_required": false,
    "supabase_green_lane_access": "read_only",
    "supabase_candidate_verification_access": "read_only",
    "supabase_candidate_write_allowed": false,
    "submit_via": "supabase_ingress_git_control_file",
    "sha256_integrity_required": true,
    "supabase_ingress_transport_access": "insert_only",
    "supabase_ingress_transport_table": "public.newsflow_candidate_ingress",
    "github_control_file": "content/state/candidate-ingress-trigger.json"
  },
  "agent_apply_ingress": {
    "transport": "supabase_ingress_git_control_file",
    "trigger_file": "content/state/candidate-ingress-trigger.json",
    "workflow": ".github/workflows/candidate-ingress.yml",
    "documentation": "docs/candidate-ingress.md",
    "result_store": "supabase:public.newsflow_candidate_ingress",
    "ingress_store": "supabase:public.newsflow_candidate_ingress",
    "ingress_store_write": "scheduled_agent_insert_only",
    "ingress_reader_auth": "github_actions_oidc",
    "ingress_reader_audience": "newsflow-supabase-candidate-ingress-reader",
    "ingress_reader_url": "https://blgwlycfcwvsupmqyqwn.supabase.co/functions/v1/newsflow-candidate-ingress-reader",
    "ingress_reader_source": "supabase/functions/newsflow-candidate-ingress-reader/index.ts",
    "canonical_command": "node scripts/apply-content.mjs --stdin --apply",
    "writer_auth": "github_actions_oidc",
    "writer_audience": "newsflow-supabase-candidate-writer",
    "writer_url": "https://blgwlycfcwvsupmqyqwn.supabase.co/functions/v1/newsflow-candidate-writer",
    "writer_source": "supabase/functions/newsflow-candidate-writer/index.ts",
    "github_long_lived_database_secret": false,
    "candidate_payload_git_tracked": false,
    "control_reference_git_tracked": true,
    "direct_candidate_sql_fallback_allowed": false,
    "max_plaintext_bytes": 32768,
    "ingress_ttl_hours": 24
  },
  "private_candidate_store": "supabase:public.newsflow_candidates",
  "private_editorial_referral_store": "supabase:public.newsflow_editorial_referrals",
  "apply_writes": [
    "supabase:public.newsflow_candidates",
    "content/runs/*.json (sanitized counts and run metadata only)"
  ],
  "public_audit_excludes_candidate_content": true,
  "forbidden_direct_writes": [
    "public/data/edition.json",
    "public/data/storylines.json",
    "public/data/issues.json",
    "public/data/news.json",
    "src/**",
    "scripts/**"
  ],
  "commands": {
    "contract_check": "npm run content:check",
    "green_lane": "SUPABASE_URL=... SUPABASE_SERVICE_ROLE_KEY=... npm run editorial:referrals -- --limit=1",
    "x_discovery": "X_BEARER_TOKEN=... npm run content:x",
    "dry_run": "node scripts/update-content.mjs --input=content/inbox/<candidate-pack.json>",
    "apply": "SUPABASE_URL=... SUPABASE_SERVICE_ROLE_KEY=... node scripts/apply-content.mjs --input=content/inbox/<candidate-pack.json> --apply",
    "agent_apply": "insert exact compact Candidate-pack JSON once into public.newsflow_candidate_ingress, then update only content/state/candidate-ingress-trigger.json on main with request_id/bytes/sha256; the path-scoped push workflow claims the payload through GitHub Actions OIDC and canonical apply persists reviewable Candidates through the existing OIDC writer",
    "verify": [
      "node scripts/check-candidate-ingress.mjs"
    ]
  },
  "terminal_outcomes": [
    "completed_no_material_change",
    "completed_dry_run",
    "completed_applied",
    "needs_human_review",
    "blocked"
  ],
  "adapters": {
    "generic": "AGENTS.md",
    "skill": "skills/newsflow-recommender/SKILL.md",
    "antigravity_rule": ".agents/rules/newsflow-content.md",
    "antigravity_workflow": ".agents/workflows/update-content.md"
  }
}
